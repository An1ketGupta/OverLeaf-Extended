{
  "name": "overleaf-pro",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": "10.34.7"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @overleaf-pro/web dev",
    "dev:api": "pnpm --filter @overleaf-pro/api dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "tsx --env-file-if-exists=.env scripts/integration.ts",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "db:generate": "drizzle-kit generate --config=packages/db/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "check:environment": "tsx scripts/check-environment.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@overleaf-pro/contracts": "workspace:*",
    "@overleaf-pro/db": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "concurrently": "10.0.6",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
