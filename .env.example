# Copy to .env at the repository root. Nothing here is a real credential.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
AUTH_SECRET=replace-with-at-least-32-random-characters
# Enable for local accounts with email verification; production rejects true.
AUTH_ALLOW_SIGNUP=false
# Local Mailpit inbox only; run pnpm mail:start in another terminal.
# Set true with AUTH_ALLOW_SIGNUP=true for local registration and recovery.
MAIL_ENABLED=false
MAIL_PORT=1025
# Optional for the scaffold; auth/readiness return 503 without a database.
# Native PostgreSQL: create two databases; use independent Neon branches remotely.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/overleaf_pro
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/overleaf_pro_test
# Neon requires TLS. Use its supplied sslmode and direct URL for migrations.
# DATABASE_MIGRATION_URL=postgresql://...
# Explicit comma-separated origins, no wildcard; production requires HTTPS.
TRUSTED_ORIGINS=http://localhost:5173
# API_ORIGIN is used only by Vite's local server proxy (never a browser secret).
API_ORIGIN=http://127.0.0.1:3001
# AI is optional and disabled by default. Use only an eligible Groq Free account.
# Do not add a payment method or enable a paid fallback. Verify provider data controls.
AI_SHARING_ENABLED=false
AI_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your-server-only-key
# Explicit synthetic live check only: AI_LIVE_CHECK=true pnpm test:ai:live
